{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "useDefineForClassFields": true,
    "lib": ["dom", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@theme": ["src/theme"],
      "@assets/*": ["src/assets/*"],
      "@components/*": ["src/components/*"],
      "@constants": ["src/constants"],
      "@types": ["src/types"],
      "@graphql/*": ["src/graphql/*"],
      "@ui/*": ["src/ui/*"],
      "@store/*": ["src/store/*"],
      "@pages/*": ["src/pages/*"],
      "@layout/*": ["src/layout/*"],
      "@layout": ["src/layout"],
      "@generated/*": ["src/__generated__/*"],
      "@hooks": ["src/hooks"],
      "@helpers": ["src/helpers"],
      "@config/*": ["src/config/*"]
    }
  },
  "include": ["src/**/*"]
}
